# SecuScan server configuration — copy to .env and adjust.
# Every variable is optional; defaults suit local development.

# Bind address. Keep 127.0.0.1 for local-only exposure.
SECUSCAN_ADDR=127.0.0.1:8080

# SQLite database (created automatically).
SECUSCAN_DB_URL=sqlite://./data/secuscan.db?mode=rwc

# REQUIRED in production: sessions survive restarts only with a stable secret.
# Generate one:  openssl rand -hex 32
SECUSCAN_JWT_SECRET=

# Plugin manifests and built frontend served by the API.
SECUSCAN_PLUGINS_DIR=./plugins
SECUSCAN_FRONTEND_DIR=./frontend/dist
SECUSCAN_DATA_DIR=./data

# First-run administrator (password is generated and printed if unset).
SECUSCAN_ADMIN_EMAIL=admin@secuscan.local
SECUSCAN_ADMIN_PASSWORD=

# Public self-registration (default off — admins create users).
SECUSCAN_ALLOW_REGISTER=false

# Set true when serving over HTTPS (adds the Secure cookie attribute).
SECUSCAN_COOKIE_SECURE=false

# Only needed for a split-domain frontend deployment.
SECUSCAN_CORS_ORIGIN=

# Capabilities no plugin may require, e.g. "exploit,docker,cloud".
SECUSCAN_DENIED_CAPABILITIES=

# Global cap on simultaneously running tasks.
SECUSCAN_MAX_CONCURRENT_TASKS=8

# How often (seconds) the recurring-scan scheduler wakes to launch due
# schedules. Does not affect interval accuracy beyond one tick.
SECUSCAN_SCHEDULE_TICK_SECS=30

# Logging: secuscan=info,tower_http=warn
RUST_LOG=secuscan=info,tower_http=warn
